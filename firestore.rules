rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        request.auth.token.email.lower() == 'drbiernd@gmail.com'
      );
    }

    // User profiles and private user data subcollections
    match /users/{userId} {
      // Users can read their own profile; admins can read all profiles
      allow read: if isOwner(userId) || isAdmin();
      
      // Users can write/sync their own basic profile info on sign-in
      allow create, update: if isOwner(userId) || isAdmin();
      
      // Only admins can delete user records
      allow delete: if isAdmin();

      // Recursive match for user subcollections (settings, data, trials, decks)
      match /{document=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Pre-approved email whitelist
    match /preapproved_emails/{email} {
      // Authenticated users can check if their own email is pre-approved on sign-in
      allow read: if isAuthenticated() && (
        request.auth.token.email.lower() == email.lower() || isAdmin()
      );
      
      // Only admins can create, update, or remove pre-approved emails
      allow write: if isAdmin();
    }

    // App Data Collections: Allow authenticated and approved users (or admins) access to application collections
    match /{document=**} {
      allow read, write: if isAuthenticated() && (
        request.auth.token.approved == true || isAdmin()
      );
    }
  }
}

